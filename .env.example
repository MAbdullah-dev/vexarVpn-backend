NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vexravpn?schema=public
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=log

# HMAC secret for access tokens. Replace this placeholder with at least 32 random bytes.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ACCESS_TOKEN_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_ABSOLUTE_TTL=90d

# Optional NestJS Observe credentials. Leave blank for local development.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
